{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user profile in the application.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The unique user ID from Firebase Auth."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "displayName": {
          "type": "string",
          "description": "The user's full name."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "The user's profile picture URL."
        },
        "cravePoints": {
          "type": "number",
          "description": "The user's accumulated loyalty points."
        },
        "driverEarnings": {
          "type": "number",
          "description": "The driver's total earnings."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the user profile was created."
        },
        "role": {
          "type": "string",
          "enum": ["customer", "restaurant", "driver", "admin"],
          "description": "The user's role in the platform."
        },
        "paymentMethods": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string" },
              "last4": { "type": "string" },
              "expiry": { "type": "string" },
              "isDefault": { "type": "boolean" }
            }
          }
        },
        "privacySettings": {
          "type": "object",
          "properties": {
            "locationAccess": { "type": "boolean" },
            "dataSharing": { "type": "boolean" },
            "personalizedAds": { "type": "boolean" },
            "twoFactor": { "type": "boolean" }
          }
        }
      },
      "required": ["uid", "email", "cravePoints", "createdAt", "role"]
    },
    "Order": {
      "title": "Order",
      "description": "A food delivery order placed by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The ID of the user who placed the order."
        },
        "restaurantId": {
          "type": "string",
          "description": "The ID of the restaurant."
        },
        "restaurantName": {
          "type": "string",
          "description": "The name of the restaurant."
        },
        "items": {
          "type": "string",
          "description": "JSON stringified array of cart items."
        },
        "total": {
          "type": "number",
          "description": "The total cost of the order."
        },
        "status": {
          "type": "string",
          "enum": ["preparing", "on_the_way", "delivered"],
          "description": "The current status of the order."
        },
        "deliveryAddress": {
          "type": "string",
          "description": "The address where the order will be delivered."
        },
        "driverLat": {
          "type": "number",
          "description": "Current latitude of the delivery driver."
        },
        "driverLng": {
          "type": "number",
          "description": "Current longitude of the delivery driver."
        },
        "estimatedDeliveryTime": {
          "type": "string",
          "format": "date-time",
          "description": "Estimated time of delivery."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the order was placed."
        }
      },
      "required": ["userId", "restaurantId", "restaurantName", "items", "total", "status", "deliveryAddress", "createdAt"]
    },
    "Suggestion": {
      "title": "Suggestion",
      "description": "A user's suggestion for new food or restaurants.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "foodType": { "type": "string" },
        "restaurantName": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "foodType", "restaurantName", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A user's comment on a restaurant.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string", "format": "uri" },
        "restaurantId": { "type": "string" },
        "text": { "type": "string" },
        "rating": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "restaurantId", "text", "rating", "createdAt"]
    },
    "Restaurant": {
      "title": "Restaurant",
      "description": "A restaurant or shop profile.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "description": "The UID of the user who owns this restaurant." },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string", "format": "uri" },
        "rating": { "type": "number" },
        "deliveryTime": { "type": "string" },
        "deliveryFee": { "type": "number" },
        "tags": { "type": "string", "description": "JSON stringified array of tags" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "description", "image", "rating", "deliveryTime", "deliveryFee", "isActive", "createdAt"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "An item on a restaurant's menu.",
      "type": "object",
      "properties": {
        "restaurantId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "image": { "type": "string", "format": "uri" },
        "category": { "type": "string" },
        "isAvailable": { "type": "boolean" }
      },
      "required": ["restaurantId", "name", "description", "price", "image", "category", "isAvailable"]
    },
    "Promotion": {
      "title": "Promotion",
      "description": "A special offer or discount from a restaurant.",
      "type": "object",
      "properties": {
        "restaurantId": { "type": "string" },
        "restaurantName": { "type": "string" },
        "type": { "type": "string", "enum": ["bogo", "discount", "fixed"] },
        "code": { "type": "string" },
        "description": { "type": "string" },
        "value": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["restaurantId", "restaurantName", "type", "code", "description", "isActive", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles."
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Stores orders placed by a specific user."
    },
    "/users/{userId}/orders/{orderId}/messages/{messageId}": {
      "schema": {
        "type": "object",
        "properties": {
          "sender": { "type": "string", "enum": ["user", "driver"] },
          "text": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["sender", "text", "createdAt"]
      },
      "description": "Chat messages between user and driver."
    },
    "/suggestions/{suggestionId}": {
      "schema": { "$ref": "#/entities/Suggestion" },
      "description": "Stores user suggestions."
    },
    "/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Stores user comments/reviews for restaurants."
    },
    "/restaurants/{restaurantId}": {
      "schema": { "$ref": "#/entities/Restaurant" },
      "description": "Stores restaurant profiles."
    },
    "/restaurants/{restaurantId}/menuItems/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Stores menu items for a specific restaurant."
    },
    "/promotions/{promotionId}": {
      "schema": { "$ref": "#/entities/Promotion" },
      "description": "Stores global promotions for efficient lookup."
    }
  }
}
